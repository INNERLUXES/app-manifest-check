<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The made-up "orders" app with its settings fixed. -->
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Orders</string>
	<key>CFBundleIdentifier</key>
	<string>com.example.orders</string>
	<key>CFBundleShortVersionString</key>
	<string>1.4.0</string>
	<key>CFBundleVersion</key>
	<string>12</string>
	<key>MinimumOSVersion</key>
	<string>16.0</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
		<string>still-camera</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Orders uses the camera to scan the label on a parcel.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Orders saves photos of delivered parcels to your library.</string>
</dict>
</plist>
